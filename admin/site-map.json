{
  "version": 1,
  "page": "index.html",
  "pageTitle": "Página inicial (landing)",
  "groups": [
    {
      "id": "seo",
      "title": "SEO e separador do browser",
      "where": "Etiqueta &lt;title&gt; e meta descrição (não visível no corpo)",
      "fields": [
        {
          "id": "seo.title",
          "label": "Título da página",
          "where": "Separador do browser / resultado Google",
          "selector": "title",
          "type": "text"
        },
        {
          "id": "seo.description",
          "label": "Meta descrição",
          "where": "Resumo em motores de busca",
          "selector": "meta[name=\"description\"]",
          "type": "attr",
          "attribute": "content"
        }
      ]
    },
    {
      "id": "cabecalho",
      "title": "Cabeçalho fixo",
      "where": "Topo em todas as secções — marca, menu e botão",
      "fields": [
        {
          "id": "header.brand.mark",
          "label": "Marca — número",
          "where": "Logo «28»",
          "selector": ".site-header .brand-mark",
          "type": "text"
        },
        {
          "id": "header.brand.text",
          "label": "Marca — texto",
          "where": "Ao lado do 28",
          "selector": ".site-header .brand-text",
          "type": "text"
        },
        {
          "id": "header.cta.text",
          "label": "Botão do topo — texto",
          "where": "Canto direito do cabeçalho",
          "selector": ".header-cta",
          "type": "text"
        },
        {
          "id": "header.cta.href",
          "label": "Botão do topo — link Kiwify",
          "where": "URL de checkout",
          "selector": ".header-cta",
          "type": "attr",
          "attribute": "href"
        }
      ]
    },
    {
      "id": "hero",
      "title": "Hero — abertura",
      "where": "Primeira dobra: texto à esquerda, fotos à direita",
      "fields": [
        {
          "id": "hero.eyebrow",
          "label": "Linha superior (eyebrow)",
          "where": "Acima do H1",
          "selector": "#hero .eyebrow",
          "type": "html",
          "hint": "Mantém o span.dot se quiseres o ponto verde."
        },
        {
          "id": "hero.h1",
          "label": "Título principal (H1)",
          "where": "Manchete grande da abertura",
          "selector": "#hero .hero-copy h1",
          "type": "text"
        },
        {
          "id": "hero.lead",
          "label": "Texto de apoio",
          "where": "Parágrafo sob o H1",
          "selector": "#hero .lead",
          "type": "text"
        },
        {
          "id": "hero.point.1",
          "label": "Bullet 1",
          "where": "Lista com vistos — 1.º item",
          "selector": "#hero .hero-points li:nth-child(1)",
          "type": "html"
        },
        {
          "id": "hero.point.2",
          "label": "Bullet 2",
          "where": "Lista com vistos — 2.º item",
          "selector": "#hero .hero-points li:nth-child(2)",
          "type": "html"
        },
        {
          "id": "hero.point.3",
          "label": "Bullet 3",
          "where": "Lista com vistos — 3.º item",
          "selector": "#hero .hero-points li:nth-child(3)",
          "type": "html"
        },
        {
          "id": "hero.point.4",
          "label": "Bullet 4",
          "where": "Lista com vistos — 4.º item",
          "selector": "#hero .hero-points li:nth-child(4)",
          "type": "html"
        },
        {
          "id": "hero.cta.text",
          "label": "Botão principal — texto",
          "where": "CTA verde no hero",
          "selector": "#hero .cta-row .btn",
          "type": "html"
        },
        {
          "id": "hero.cta.href",
          "label": "Botão principal — link",
          "where": "URL Kiwify do CTA",
          "selector": "#hero .cta-row .btn",
          "type": "attr",
          "attribute": "href"
        },
        {
          "id": "hero.trust.1",
          "label": "Confiança — linha 1",
          "where": "Sob o botão",
          "selector": "#hero .trust-row li:nth-child(1)",
          "type": "html"
        },
        {
          "id": "hero.trust.2",
          "label": "Confiança — linha 2",
          "where": "Sob o botão",
          "selector": "#hero .trust-row li:nth-child(2)",
          "type": "text"
        },
        {
          "id": "hero.trust.3",
          "label": "Confiança — linha 3",
          "where": "Sob o botão",
          "selector": "#hero .trust-row li:nth-child(3)",
          "type": "text"
        },
        {
          "id": "hero.photo.hero",
          "label": "Fotografia grande (placeholder)",
          "where": "Retângulo tracejado em cima à direita",
          "selector": "#hero [data-photo=\"hero\"]",
          "type": "image-slot"
        },
        {
          "id": "hero.pill.1",
          "label": "Etiqueta «4 semanas»",
          "where": "Pills sobre a foto",
          "selector": "#hero .hero-badges .pill:nth-child(1)",
          "type": "text"
        },
        {
          "id": "hero.pill.2",
          "label": "Etiqueta «3 níveis»",
          "where": "Pills sobre a foto",
          "selector": "#hero .hero-badges .pill:nth-child(2)",
          "type": "text"
        },
        {
          "id": "hero.pill.3",
          "label": "Etiqueta «Sem pesos»",
          "where": "Pills sobre a foto",
          "selector": "#hero .hero-badges .pill:nth-child(3)",
          "type": "text"
        },
        {
          "id": "hero.guia.thumb",
          "label": "Miniatura página 8 do guia",
          "where": "Figura do PDF abaixo da foto",
          "selector": "#hero .hero-page img",
          "type": "image",
          "lightboxSelector": "#hero .hero-page .thumb-zoom"
        },
        {
          "id": "hero.guia.caption",
          "label": "Legenda da miniatura",
          "where": "Texto sob a página 8",
          "selector": "#hero .hero-page figcaption",
          "type": "text"
        }
      ]
    },
    {
      "id": "programa",
      "title": "Secção «O programa»",
      "where": "Abaixo do hero — grelha de benefícios",
      "fields": [
        {
          "id": "programa.kicker",
          "label": "Rótulo da secção",
          "where": "Texto pequeno acima do H2",
          "selector": "#programa .kicker",
          "type": "text"
        },
        {
          "id": "programa.h2",
          "label": "Título da secção",
          "where": "H2 «O que é…»",
          "selector": "#programa .section-head h2",
          "type": "text"
        },
        {
          "id": "programa.lead",
          "label": "Introdução",
          "where": "Parágrafo sob o H2",
          "selector": "#programa .section-lead",
          "type": "text"
        },
        {
          "id": "programa.photo",
          "label": "Fotografia sala de casa",
          "where": "Bloco imagem + texto «Não precisas de ginásio…»",
          "selector": "#programa [data-photo=\"programa\"]",
          "type": "image-slot"
        },
        {
          "id": "programa.split.h3",
          "label": "Título do bloco lateral",
          "where": "H3 ao lado da foto",
          "selector": "#programa .split-text h3",
          "type": "text"
        },
        {
          "id": "programa.split.p1",
          "label": "Parágrafo 1",
          "where": "Texto ao lado da foto",
          "selector": "#programa .split-text p:nth-of-type(1)",
          "type": "text"
        },
        {
          "id": "programa.split.p2",
          "label": "Parágrafo 2",
          "where": "Formato PDF",
          "selector": "#programa .split-text p:nth-of-type(2)",
          "type": "text"
        }
      ]
    },
    {
      "id": "como-funciona",
      "title": "Como funcionam as 4 semanas",
      "where": "Meio da página — calendário e passos",
      "fields": [
        {
          "id": "como.kicker",
          "label": "Rótulo",
          "where": "Acima do H2",
          "selector": "#como-funciona .kicker",
          "type": "text"
        },
        {
          "id": "como.h2",
          "label": "Título",
          "where": "H2 principal",
          "selector": "#como-funciona .section-head h2",
          "type": "text"
        },
        {
          "id": "como.lead",
          "label": "Introdução",
          "where": "Sob o título",
          "selector": "#como-funciona .section-lead",
          "type": "text"
        },
        {
          "id": "como.calendario.img",
          "label": "Imagem página 13",
          "where": "Figura do calendário",
          "selector": "#como-funciona .how-media img",
          "type": "image"
        },
        {
          "id": "como.calendario.caption",
          "label": "Legenda página 13",
          "where": "Sob a imagem",
          "selector": "#como-funciona .how-media figcaption",
          "type": "text"
        }
      ]
    },
    {
      "id": "incluido",
      "title": "O que vais receber",
      "where": "Secção escura com lista e amostras",
      "fields": [
        {
          "id": "incluido.h2",
          "label": "Título",
          "where": "H2 da secção escura",
          "selector": "#incluido .section-head h2",
          "type": "text"
        },
        {
          "id": "incluido.lead",
          "label": "Introdução",
          "where": "Sob o título",
          "selector": "#incluido .section-lead",
          "type": "text"
        },
        {
          "id": "incluido.sample.h3",
          "label": "Título amostra",
          "where": "«Vê o interior antes…»",
          "selector": "#amostra .sample-head h3",
          "type": "text"
        },
        {
          "id": "incluido.sample.p",
          "label": "Texto amostra",
          "where": "Sob o título da amostra",
          "selector": "#amostra .sample-head p",
          "type": "text"
        },
        {
          "id": "incluido.sample.p08",
          "label": "Miniatura amostra página 8",
          "where": "Primeira carta ampliável",
          "selector": "#amostra .sample-grid .sample-card:nth-child(1) img",
          "type": "image",
          "lightboxSelector": "#amostra .sample-grid .sample-card:nth-child(1) .sample-zoom"
        },
        {
          "id": "incluido.sample.p13",
          "label": "Miniatura amostra página 13",
          "where": "Segunda carta ampliável",
          "selector": "#amostra .sample-grid .sample-card:nth-child(2) img",
          "type": "image",
          "lightboxSelector": "#amostra .sample-grid .sample-card:nth-child(2) .sample-zoom"
        }
      ]
    },
    {
      "id": "depoimentos",
      "title": "Depoimentos / testemunhos",
      "where": "Secção «Quem já seguiu o guia» — antes da oferta",
      "fields": [
        {
          "id": "depoimentos.kicker",
          "label": "Rótulo da secção",
          "where": "Texto pequeno «Testemunhos»",
          "selector": "#depoimentos .kicker",
          "type": "text"
        },
        {
          "id": "depoimentos.h2",
          "label": "Título da secção",
          "where": "H2 «Quem já seguiu o guia»",
          "selector": "#depoimentos .section-head h2",
          "type": "text"
        },
        {
          "id": "depoimentos.empty.title",
          "label": "Título do aviso (sem depoimentos)",
          "where": "Caixa central quando ainda não há testemunhos",
          "selector": "#depoimentos .empty-title",
          "type": "text"
        },
        {
          "id": "depoimentos.empty.text",
          "label": "Texto explicativo do vazio",
          "where": "Parágrafo por baixo do título do aviso",
          "selector": "#depoimentos .testimonial-empty p:nth-of-type(2)",
          "type": "text"
        },
        {
          "id": "depoimentos.card1.quote",
          "label": "Depoimento 1 — texto",
          "where": "Cartão 1 (só aparece se preencheres)",
          "selector": "#depoimentos .testimonial-card[data-index=\"1\"] .testimonial-quote",
          "type": "text"
        },
        {
          "id": "depoimentos.card1.name",
          "label": "Depoimento 1 — nome",
          "where": "Rodapé do cartão 1",
          "selector": "#depoimentos .testimonial-card[data-index=\"1\"] .testimonial-name",
          "type": "text"
        },
        {
          "id": "depoimentos.card1.meta",
          "label": "Depoimento 1 — detalhe",
          "where": "Ex.: cidade, nível ou «leitora autorizada»",
          "selector": "#depoimentos .testimonial-card[data-index=\"1\"] .testimonial-meta",
          "type": "text"
        },
        {
          "id": "depoimentos.card1.photo",
          "label": "Depoimento 1 — foto",
          "where": "Avatar circular (opcional)",
          "selector": "#depoimentos .testimonial-card[data-index=\"1\"] .testimonial-avatar",
          "type": "image"
        },
        {
          "id": "depoimentos.card2.quote",
          "label": "Depoimento 2 — texto",
          "where": "Cartão 2",
          "selector": "#depoimentos .testimonial-card[data-index=\"2\"] .testimonial-quote",
          "type": "text"
        },
        {
          "id": "depoimentos.card2.name",
          "label": "Depoimento 2 — nome",
          "where": "Rodapé do cartão 2",
          "selector": "#depoimentos .testimonial-card[data-index=\"2\"] .testimonial-name",
          "type": "text"
        },
        {
          "id": "depoimentos.card2.meta",
          "label": "Depoimento 2 — detalhe",
          "where": "Linha secundária do cartão 2",
          "selector": "#depoimentos .testimonial-card[data-index=\"2\"] .testimonial-meta",
          "type": "text"
        },
        {
          "id": "depoimentos.card2.photo",
          "label": "Depoimento 2 — foto",
          "where": "Avatar do cartão 2",
          "selector": "#depoimentos .testimonial-card[data-index=\"2\"] .testimonial-avatar",
          "type": "image"
        },
        {
          "id": "depoimentos.card3.quote",
          "label": "Depoimento 3 — texto",
          "where": "Cartão 3",
          "selector": "#depoimentos .testimonial-card[data-index=\"3\"] .testimonial-quote",
          "type": "text"
        },
        {
          "id": "depoimentos.card3.name",
          "label": "Depoimento 3 — nome",
          "where": "Rodapé do cartão 3",
          "selector": "#depoimentos .testimonial-card[data-index=\"3\"] .testimonial-name",
          "type": "text"
        },
        {
          "id": "depoimentos.card3.meta",
          "label": "Depoimento 3 — detalhe",
          "where": "Linha secundária do cartão 3",
          "selector": "#depoimentos .testimonial-card[data-index=\"3\"] .testimonial-meta",
          "type": "text"
        },
        {
          "id": "depoimentos.card3.photo",
          "label": "Depoimento 3 — foto",
          "where": "Avatar do cartão 3",
          "selector": "#depoimentos .testimonial-card[data-index=\"3\"] .testimonial-avatar",
          "type": "image"
        }
      ]
    },
