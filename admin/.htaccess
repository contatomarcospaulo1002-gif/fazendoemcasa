# Painel administrativo — fazendoemcasa.com
#
# Defesa em profundidade: a raiz já bloqueia os JSONs de dados, mas este
# arquivo garante o bloqueio mesmo que a regra da raiz seja removida.
# O painel legado lê o conteúdo por admin/api/content.php (com sessão).

<IfModule mod_authz_core.c>
  <FilesMatch "^(content|site-map)\.json$">
    Require all denied
  </FilesMatch>
  <FilesMatch "^content\.json\.bak">
    Require all denied
  </FilesMatch>
</IfModule>
<IfModule !mod_authz_core.c>
  <FilesMatch "^(content|site-map)\.json$">
    Order allow,deny
    Deny from all
  </FilesMatch>
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(html|js|css)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>
