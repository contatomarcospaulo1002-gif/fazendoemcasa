# Segurança e publicação — fazendoemcasa.com (Apache/cPanel)
Options -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Bloquear repositório Git e ferramentas internas na web
  RewriteRule ^\.git - [F,L]
  RewriteRule ^\.github - [F,L]
  RewriteRule ^\.vscode - [F,L]
  RewriteRule ^docs/ - [F,L]
  RewriteRule ^scripts/ - [F,L]
  RewriteRule ^docker/ - [F,L]
  RewriteRule ^admin/var/ - [F,L]
  # Scripts de manutenção: somente CLI (ver admin/tools/_guard.php)
  RewriteRule ^admin/tools/ - [F,L]
  # Código interno do CMS multi-projeto: nunca servido diretamente
  RewriteRule ^admin/cms/ - [F,L]

  # Ficheiros de configuração e ambiente
  RewriteRule (^|/)\.env$ - [F,L]
  RewriteRule (^|/)docker\.env$ - [F,L]
  RewriteRule (^|/)admin/config\.local\.php$ - [F,L]

  # Dados internos do painel: nunca servidos como ficheiro estático.
  # O conteúdo legítimo chega ao painel por admin/api/content.php (com sessão).
  RewriteRule ^admin/(content|site-map)\.json$ - [F,L]
  RewriteRule ^admin/content\.json\.bak - [F,L]

  # Alias legado /painel -> admin. Substituído por redirect 301: manter o
  # symlink obrigava a duplicar todas as regras de bloqueio (e qualquer
  # regra nova seria esquecida).
  RewriteRule ^painel/?$ /admin/ [R=301,L]
  RewriteRule ^painel/(.*)$ /admin/$1 [R=301,L]

  # Resíduos de diagnóstico
  RewriteRule ^_probe\.txt$ - [F,L]

  # Bibliotecas internas da área de membros (não são endpoints)
  RewriteRule ^user/api/(bootstrap|members)\.php$ - [F,L]

  # Backups gerados pelo CMS
  RewriteRule ^index\.html\.bak\. - [F,L]
  RewriteRule (^|/)\.tmp- - [F,L]
</IfModule>

<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Permissions-Policy "geolocation=(), microphone=(), camera=()"
</IfModule>

# php -- BEGIN cPanel-generated handler, do not edit
# Set the “ea-php82” package as the default “PHP” programming language.
<IfModule mime_module>
  AddHandler application/x-httpd-ea-php82 .php .php8 .phtml
</IfModule>
# php -- END cPanel-generated handler, do not edit
